/*
  # Impede MIME sniffing
  X-Content-Type-Options: nosniff

  # Anti-clickjacking
  X-Frame-Options: SAMEORIGIN

  # Controla informações de referrer
  Referrer-Policy: strict-origin-when-cross-origin

  # Restringe permissões de hardware desnecessárias
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

  # Isola janelas abertas (compatível com window.open do WhatsApp)
  Cross-Origin-Opener-Policy: same-origin-allow-popups

  # Força HTTPS por 1 ano
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Content Security Policy
  # - script-src: SHA256 hashes dos scripts inline (GCLID tracking) + Cloudflare Insights
  # - style-src unsafe-inline: necessário para o <style> das @font-face (considerar hash futuro)
  # - font-src self: fontes auto-hospedadas em /fonts/
  # - connect-src: permite chamadas ao Worker de GCLID + Cloudflare Insights beacon
  # - img-src data:: permite favicons inline e imagens SVG embutidas
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-mOzp8rdCJOq5Ps/31Ej4OShHNlo5LCaQ/Pmr7vEauHk=' 'sha256-29CdHwWcdZIeSqnBVEUGaFi1Zmo8WkQOjtou8v+yw+s=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://roangela-gclid.alukser.workers.dev https://static.cloudflareinsights.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self';
