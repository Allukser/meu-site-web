---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Roangela Rocha | Psicóloga — Psicoterapia online e presencial",
  description = "Psicoterapia online e presencial com acolhimento, técnica e sem julgamentos. CRP 06-143094.",
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

/** Subconjunto de pesos para menos bytes; display=swap já no CSS do Google */
const fontsHref =
  'https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500&display=swap';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#5E8070" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="preload" href={fontsHref} as="style" />
    <link rel="stylesheet" href={fontsHref} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={fontsHref} /></noscript>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pt_BR" />
    {canonical && <meta property="og:url" content={canonical} />}

    <!-- ─── GCLID: captura imediata do parâmetro de URL ─────────────────── -->
    <script is:inline>
      (function () {
        try {
          var gclid = new URLSearchParams(window.location.search).get('gclid');
          if (gclid) {
            localStorage.setItem('_gc', JSON.stringify({
              gclid:  gclid,
              ts:     Date.now(),
              lp:     window.location.pathname,
              synced: false          // será marcado true após migração ao Worker
            }));
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />

    <!-- ─── GCLID: migração para storage + tracking de cliques WA ─────── -->
    <script is:inline>
      (function () {
        /* ⚠️  Após criar o Worker, substitua pela URL real               */
        var ENDPOINT = 'https://roangela-gclid.alukser.workers.dev/lead';
        var TTL_MS   = 90 * 24 * 60 * 60 * 1000; // 90 dias

        /* ── Helpers ──────────────────────────────────────────────────── */
        function readGc() {
          try {
            var d = JSON.parse(localStorage.getItem('_gc') || 'null');
            if (!d) return null;
            if (Date.now() - d.ts > TTL_MS) { localStorage.removeItem('_gc'); return null; }
            return d;
          } catch (e) { return null; }
        }

        function beacon(payload) {
          var body = JSON.stringify(payload);
          try {
            fetch(ENDPOINT, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: body, keepalive: true }).catch(Object);
          } catch (e) {}
        }

        /* ── 1. MIGRAÇÃO PASSIVA ──────────────────────────────────────── */
        /* Roda em idle: persiste o GCLID no Worker mesmo sem clique WA   */
        function passiveSync() {
          var gc = readGc();
          if (!gc || gc.synced) return;
          beacon({ gclid: gc.gclid, captured_at: gc.ts, clicked_at: Date.now(),
                   landing_page: gc.lp, source: 'page_view', event_type: 'page_view' });
          try { gc.synced = true; localStorage.setItem('_gc', JSON.stringify(gc)); } catch (e) {}
        }

        /* ── 2. CLIQUE NO WHATSAPP ────────────────────────────────────── */
        function onWaClick(e) {
          var el  = e.currentTarget;
          var gc  = readGc();
          if (gc) {
            var sec = el.closest('section, header, footer');
            beacon({ gclid: gc.gclid, captured_at: gc.ts, clicked_at: Date.now(),
                     landing_page: gc.lp,
                     source:       sec ? (sec.id || sec.tagName.toLowerCase()) : 'float',
                     event_type:   'wa_click' });
          }
          /* Abre WhatsApp independente de GCLID */
          var href = el.getAttribute('href');
          if (href) { e.preventDefault(); window.open(href, '_blank', 'noopener'); }
        }

        /* ── 3. INIT ──────────────────────────────────────────────────── */
        function init() {
          /* Migração passiva em idle — sem impacto no LCP */
          ('requestIdleCallback' in window)
            ? requestIdleCallback(passiveSync, { timeout: 4000 })
            : setTimeout(passiveSync, 1500);

          /* Intercepta todos os botões wa.me */
          document.querySelectorAll('a[href*="wa.me"]').forEach(function (el) {
            el.addEventListener('click', onWaClick);
          });
        }

        document.readyState === 'loading'
          ? document.addEventListener('DOMContentLoaded', init)
          : init();
      })();
    </script>
  </body>
</html>
