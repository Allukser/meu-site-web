---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Roangela Rocha | Psicóloga — Psicoterapia online e presencial",
  description = "Psicoterapia online e presencial com acolhimento, técnica e sem julgamentos. CRP 06-143094.",
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#5E8070" />
    <!-- ─── Fontes auto-hospedadas (sem round-trip Google Fonts) ──────────── -->
    <style>
      /* DM Sans — latin-ext */
      @font-face {
        font-family: 'DM Sans';
        font-style: normal;
        font-weight: 400 500;
        font-display: swap;
        src: url('/fonts/dm-sans-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7,
          U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F,
          U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113,
          U+2C60-2C7F, U+A720-A7FF;
      }
      /* DM Sans — latin */
      @font-face {
        font-family: 'DM Sans';
        font-style: normal;
        font-weight: 400 500;
        font-display: swap;
        src: url('/fonts/dm-sans-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC,
          U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F,
          U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      /* DM Serif Display — normal, latin-ext */
      @font-face {
        font-family: 'DM Serif Display';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/dm-serif-display-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7,
          U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F,
          U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113,
          U+2C60-2C7F, U+A720-A7FF;
      }
      /* DM Serif Display — normal, latin */
      @font-face {
        font-family: 'DM Serif Display';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/dm-serif-display-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC,
          U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F,
          U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      /* DM Serif Display — italic, latin-ext */
      @font-face {
        font-family: 'DM Serif Display';
        font-style: italic;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/dm-serif-display-italic-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7,
          U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F,
          U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113,
          U+2C60-2C7F, U+A720-A7FF;
      }
      /* DM Serif Display — italic, latin */
      @font-face {
        font-family: 'DM Serif Display';
        font-style: italic;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/dm-serif-display-italic-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC,
          U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F,
          U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
    </style>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pt_BR" />
    {canonical && <meta property="og:url" content={canonical} />}

    <!-- ─── GCLID: captura imediata do parâmetro de URL ─────────────────── -->
    <script is:inline>
      (function () {
        try {
          var gclid = new URLSearchParams(window.location.search).get('gclid');
          if (gclid) {
            localStorage.setItem('_gc', JSON.stringify({
              gclid:  gclid,
              ts:     Date.now(),
              lp:     window.location.pathname,
              synced: false          // será marcado true após migração ao Worker
            }));
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />

    <!-- ─── GCLID: migração para storage + tracking de cliques WA ─────── -->
    <script is:inline>
      (function () {
        /* ⚠️  Após criar o Worker, substitua pela URL real               */
        var ENDPOINT = 'https://roangela-gclid.alukser.workers.dev/lead';
        var TTL_MS   = 90 * 24 * 60 * 60 * 1000; // 90 dias

        /* ── Helpers ──────────────────────────────────────────────────── */
        function readGc() {
          try {
            var d = JSON.parse(localStorage.getItem('_gc') || 'null');
            if (!d) return null;
            if (Date.now() - d.ts > TTL_MS) { localStorage.removeItem('_gc'); return null; }
            return d;
          } catch (e) { return null; }
        }

        function beacon(payload) {
          var body = JSON.stringify(payload);
          try {
            fetch(ENDPOINT, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: body, keepalive: true }).catch(Object);
          } catch (e) {}
        }

        /* ── 1. MIGRAÇÃO PASSIVA ──────────────────────────────────────── */
        /* Roda em idle: persiste o GCLID no Worker mesmo sem clique WA   */
        function passiveSync() {
          var gc = readGc();
          if (!gc || gc.synced) return;
          beacon({ gclid: gc.gclid, captured_at: gc.ts, clicked_at: Date.now(),
                   landing_page: gc.lp, source: 'page_view', event_type: 'page_view' });
          try { gc.synced = true; localStorage.setItem('_gc', JSON.stringify(gc)); } catch (e) {}
        }

        /* ── 2. CLIQUE NO WHATSAPP ────────────────────────────────────── */
        function onWaClick(e) {
          var el  = e.currentTarget;
          var gc  = readGc();
          if (gc) {
            var sec = el.closest('section, header, footer');
            beacon({ gclid: gc.gclid, captured_at: gc.ts, clicked_at: Date.now(),
                     landing_page: gc.lp,
                     source:       sec ? (sec.id || sec.tagName.toLowerCase()) : 'float',
                     event_type:   'wa_click' });
          }
          /* Abre WhatsApp independente de GCLID */
          var href = el.getAttribute('href');
          if (href) { e.preventDefault(); window.open(href, '_blank', 'noopener'); }
        }

        /* ── 3. INIT ──────────────────────────────────────────────────── */
        function init() {
          /* Migração passiva em idle — sem impacto no LCP */
          ('requestIdleCallback' in window)
            ? requestIdleCallback(passiveSync, { timeout: 4000 })
            : setTimeout(passiveSync, 1500);

          /* Intercepta todos os botões wa.me */
          document.querySelectorAll('a[href*="wa.me"]').forEach(function (el) {
            el.addEventListener('click', onWaClick);
          });
        }

        document.readyState === 'loading'
          ? document.addEventListener('DOMContentLoaded', init)
          : init();
      })();
    </script>
  </body>
</html>
