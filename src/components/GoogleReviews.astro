---
const placeId = "ChIJu8a1u1xEwpQR0YaNUSKznyc";
---
<section class="reviews section" id="avaliacoes">
  <div class="container">
    <div class="reviews__header">
      <span class="tag">Avaliações verificadas</span>
      <div class="divider"></div>
      <h2 class="section-heading">Confira o que<br><em>meus clientes dizem</em></h2>
      <p class="section-sub">Todas as avaliações são verificadas pelo Google e refletem a experiência real de clientes.</p>
    </div>
    <div class="reviews__cta">
      <button class="reviews-btn" id="openReviewsModal"><span class="reviews-btn__icon">⭐</span>Ver avaliações no Google</button>
    </div>
  </div>
</section>

<div class="modal modal-reviews" id="reviewsModal">
  <div class="modal-overlay" id="modalOverlay"></div>
  <div class="modal-content">
    <button class="modal-close" id="closeReviewsModal" aria-label="Fechar">✕</button>
    <div class="modal-frame">
      <iframe
        src={`https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3655.108732640971!2d-46.6584!3d-23.5905!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94ce596b7b3c0001%3A${placeId}!2sRo%20Angela%20Rocha%20Psicologa!5e0!3m2!1spt-BR!2sbr`}
        width="100%"
        height="100%"
        style="border:0;"
        allowFullScreen=""
        loading="lazy"
        referrerPolicy="no-referrer-when-downgrade"
        title="Avaliações no Google"
      ></iframe>
    </div>
  </div>
</div>

<script>
const modal = document.getElementById("reviewsModal");
const openBtn = document.getElementById("openReviewsModal");
const closeBtn = document.getElementById("closeReviewsModal");
const overlay = document.getElementById("modalOverlay");

openBtn.addEventListener("click", () => {
  modal.classList.add("modal--open");
  document.body.style.overflow = "hidden";
});

const closeModal = () => {
  modal.classList.remove("modal--open");
  document.body.style.overflow = "auto";
};

closeBtn.addEventListener("click", closeModal);
overlay.addEventListener("click", closeModal);

document.addEventListener("keydown", (e) => {
  if (e.key === "Escape" && modal.classList.contains("modal--open")) {
    closeModal();
  }
});
</script>

<style>
.reviews { margin: 4rem 0; }
.reviews__header { max-width: 540px; margin-bottom: 3rem; }
.reviews__cta { text-align: center; }
.reviews-btn {
  background: linear-gradient(135deg, #34A853 0%, #2d8e47 100%);
  color: white;
  border: none;
  border-radius: var(--radius-md);
  padding: 1rem 2rem;
  font-size: 1rem;
  font-weight: 500;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
  box-shadow: 0 4px 12px rgba(52, 168, 83, 0.3);
}
.reviews-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(52, 168, 83, 0.4);
  background: linear-gradient(135deg, #2d8e47 0%, #228d4f 100%);
}
.reviews-btn:active { transform: translateY(0); }
.reviews-btn__icon { font-size: 1.2rem; }
.modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 1000; }
.modal--open { display: flex; align-items: center; justify-content: center; animation: fadeIn 0.3s ease-out; }
.modal-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.6); cursor: pointer; }
.modal-content { position: relative; background: white; border-radius: var(--radius-lg); box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3); width: 90vw; max-width: 900px; height: 80vh; max-height: 600px; display: flex; flex-direction: column; animation: slideUp 0.3s ease-out; z-index: 1001; }
.modal-close { position: absolute; top: 1rem; right: 1rem; z-index: 1002; background: rgba(0, 0, 0, 0.1); border: none; width: 40px; height: 40px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; transition: background 0.2s; color: var(--warm-900); }
.modal-close:hover { background: rgba(0, 0, 0, 0.2); }
.modal-frame { flex: 1; overflow: hidden; border-radius: 0 0 var(--radius-lg) var(--radius-lg); }
.modal-frame iframe { display: block; width: 100%; height: 100%; }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
@media (max-width: 720px) { .modal-content { width: 95vw; height: 85vh; max-height: 500px; } .reviews-btn { padding: 0.875rem 1.5rem; font-size: 0.95rem; } }
</style>