---
// Galeria profissional - Grid limpo com hover elegante
const fotos = [
  { id: 1, alt: "Retrato profissional - Rosangela" },
  { id: 2, alt: "Retrato profissional - Rosangela" },
  { id: 3, alt: "Retrato profissional - Rosangela" },
  { id: 4, alt: "Retrato profissional - Rosangela" },
  { id: 5, alt: "Retrato profissional - Rosangela" },
  { id: 6, alt: "Retrato profissional - Rosangela" },
  { id: 7, alt: "Retrato profissional - Rosangela" },
  { id: 8, alt: "Retrato profissional - Rosangela" },
];
---

<section class="galeria section" id="galeria">
  <div class="container">
    <div class="galeria__header">
      <span class="tag">Portfólio</span>
      <div class="divider"></div>
      <h2 class="section-heading">
        Sessões Fotográficas<br>
        <em>Profissionais</em>
      </h2>
      <p class="section-sub">
        Registros de alta qualidade para mídia, redes sociais e material institucional.
      </p>
    </div>

    <div class="galeria__grid">
      {fotos.map((foto) => (
        <article class="galeria__card">
          <div class="galeria__image-wrapper">
            <img
              src={`/images/rosangela/foto-${foto.id}.jpg`}
              alt={foto.alt}
              loading="lazy"
              decoding="async"
            />
            <div class="galeria__overlay">
              <div class="galeria__info">
                <p class="galeria__caption">Retrato Profissional</p>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.galeria {
  margin: 5rem 0;
}

.galeria__header {
  max-width: 540px;
  margin-bottom: 4rem;
}

.galeria__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 2rem;
  margin-top: 3rem;
}

.galeria__card {
  position: relative;
  overflow: hidden;
}

.galeria__image-wrapper {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-lg);
  aspect-ratio: 3/4;
  background: var(--sand-100);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  transition: box-shadow 0.3s ease;
}

.galeria__card:hover .galeria__image-wrapper {
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.15);
}

.galeria__image-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.galeria__card:hover img {
  transform: scale(1.06);
}

.galeria__overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0) 50%, rgba(0, 0, 0, 0.3) 100%);
  display: flex;
  align-items: flex-end;
  padding: 1.5rem;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.galeria__card:hover .galeria__overlay {
  opacity: 1;
}

.galeria__info {
  color: white;
  text-align: center;
  width: 100%;
}

.galeria__caption {
  font-size: 0.9rem;
  font-weight: 500;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  opacity: 0.9;
}

/* Responsive */
@media (max-width: 768px) {
  .galeria {
    margin: 3rem 0;
  }

  .galeria__header {
    margin-bottom: 2rem;
  }

  .galeria__grid {
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }
}
</style>