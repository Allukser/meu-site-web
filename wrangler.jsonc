{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meu-site-web",
  "compatibility_date": "2025-05-12",
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    { "pattern": "psicorosangelarocha.com", "custom_domain": true },
    { "pattern": "www.psicorosangelarocha.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
